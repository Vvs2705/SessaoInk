# SessãoInk — exemplo de variáveis de ambiente (RAIZ)
# Copie para .env e preencha. NUNCA versione .env com valores reais.
# Em produção, os secrets vivem na plataforma (Fly secrets / Vercel env), não aqui.

# ─── Ambiente ────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | test | production
DEBUG=true                       # DEVE ser false em produção (guardrail aborta startup)

# ─── Segurança ───────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sessaoink-api
JWT_AUDIENCE=sessaoink-app

# Origens permitidas (CORS + validação CSRF). Em produção: domínios Vercel reais.
ALLOWED_ORIGINS=http://localhost:3000

# Backend atrás de proxy confiável (Vercel + Fly). Desligue só se houver tráfego direto não confiável.
TRUSTED_PROXY_ENABLED=true

# ─── Banco / Cache ───────────────────────────────────────────────────────────
# Produção: Neon (não-localhost) — guardrail bloqueia localhost em produção.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sessaoink
REDIS_URL=redis://localhost:6379

# ─── Storage / Uploads ───────────────────────────────────────────────────────
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE_MB=15

# ─── Observabilidade (opcional) ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Em produção NÃO defina aqui — use `fly secrets set RESEND_API_KEY=...`
RESEND_API_KEY=
RESEND_FROM=SessãoInk <onboarding@resend.dev>
APP_URL=http://localhost:3000

# ─── Frontend (Vercel) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL  → NÃO DEFINIR (ausência ativa o modo proxy)
# BACKEND_URL          → https://sessaoink-api.fly.dev (server-only, usado pelo proxy)
