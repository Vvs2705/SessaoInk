# SessãoInk — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+asyncpg://sessaoink:SENHA_AQUI@localhost:5432/sessaoink

# Redis (sem senha: redis://localhost:6379/0)
# Com senha: redis://:SENHA_REDIS@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Chave secreta para JWT — gere com: openssl rand -hex 64
SECRET_KEY=troque_por_chave_de_64_chars_gerada_aleatoriamente

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development
DEBUG=true
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE_MB=15

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
